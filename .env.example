# Dev-only credentials, matching compose.yaml. Replace them everywhere else.
DATABASE_URL=postgres://api_app:api_app_dev_password@127.0.0.1:5432/api?sslmode=disable
MIGRATION_DATABASE_URL=postgres://api_owner:api_owner_dev_password@127.0.0.1:5432/api?sslmode=disable

PORT=3000
LOG_LEVEL=info
DATABASE_STATEMENT_TIMEOUT_MS=5000
# Pool size. Empty uses pool_max_conns from DATABASE_URL, or 10.
DATABASE_POOL_MAX=

# Comma-separated browser origins. Leave empty to disable CORS.
CORS_ORIGINS=

# How many proxies in front of the API append to X-Forwarded-For. 0 ignores the header.
TRUST_PROXY_HOPS=0

# Session lifetime, at most 9600 (400 days), which is the longest cookie browsers keep.
SESSION_TTL_HOURS=168
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
# Failed logins per account, from any address, before login returns 429 for the window.
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900

# On SIGTERM, /readyz returns 503 for SHUTDOWN_DRAIN_SECONDS while requests are still served, then in-flight
# requests get SHUTDOWN_TIMEOUT_SECONDS to finish. The timeout can't be below the 30-second write timeout.
SHUTDOWN_DRAIN_SECONDS=5
SHUTDOWN_TIMEOUT_SECONDS=30

# Serves Swagger UI at /docs and the spec at /openapi.json. Leave it off in production unless you mean to publish them.
DOCS_ENABLED=true

# Set to send traces, metrics, and errors to an OTLP/HTTP collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=api-go-starter

# Lets `make seed` add the fake demo user. Never set it in production.
SEED_DEMO_DATA=true
